#!/usr/bin/env bash
set -euo pipefail

read_value() {
  local label="$1"
  local default="${2:-}"
  local value
  if [[ -n "$default" ]]; then
    read -r -p "$label [$default]: " value
    printf '%s' "${value:-$default}"
  else
    read -r -p "$label: " value
    printf '%s' "$value"
  fi
}

read_secret() {
  local label="$1"
  local value
  read -r -s -p "$label: " value
  printf '\n' >&2
  printf '%s' "$value"
}

email="${SYSTEM_ADMIN_EMAIL:-}"
first_name="${SYSTEM_ADMIN_FIRST_NAME:-}"
last_name="${SYSTEM_ADMIN_LAST_NAME:-}"
password="${SYSTEM_ADMIN_PASSWORD:-}"

if [[ -z "$email" ]]; then
  email="$(read_value 'System Admin email')"
fi

if [[ -z "$first_name" ]]; then
  first_name="$(read_value 'First name' 'System')"
fi

if [[ -z "$last_name" ]]; then
  last_name="$(read_value 'Last name' 'Administrator')"
fi

if [[ -z "$password" ]]; then
  password="$(read_secret 'System Admin password')"
  confirm="$(read_secret 'Confirm password')"
  if [[ "$password" != "$confirm" ]]; then
    echo "Passwords do not match." >&2
    exit 2
  fi
fi

uv run --no-sync python -m scripts.seed_system_admin \
  --email "$email" \
  --first-name "$first_name" \
  --last-name "$last_name" \
  --password "$password" \
  --no-prompt
