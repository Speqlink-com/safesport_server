ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://safesport:safesport@db:5432/safesport
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=
ZOHO_FROM_NAME=SafeSport
EMAIL_DELIVERY_MODE=smtp
SAFESPORT_LOGO_URL=https://res.cloudinary.com/dfyqn0c1t/image/upload/v1790532798/safesport_1_roaybx.png
UPLOADS_DIR=uploads
MAX_LOGO_BYTES=2097152

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_INSTITUTION_FOLDER=safesport/institutions

# Optional dedicated storage for AI movement-screening videos.
# If blank, movement uploads fall back to the general Cloudinary settings above.
MOVEMENT_CLOUDINARY_CLOUD_NAME=
MOVEMENT_CLOUDINARY_API_KEY=
MOVEMENT_CLOUDINARY_API_SECRET=
MOVEMENT_CLOUDINARY_UPLOAD_PRESET=
MOVEMENT_CLOUDINARY_FOLDER=safesport/movement/originals

# Movement AI provider settings. The current integrated module stores uploads/results in this DB;
# these settings are reserved for the real pose/LLM worker integration.
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=false
LLM_PROVIDER=
LLM_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
POSE_PROVIDER=prototype
POSE_MODEL=
POSE_DEVICE=cpu
POSE_CONFIDENCE_THRESHOLD=0.50
MOVEMENT_TEMP_DIR=/tmp/safesport
AI_JOB_MAX_RETRIES=3
MOVEMENT_MAX_DURATION_SECONDS=60

# Used only by scripts/seed_system_admin.py. Prefer an interactive password prompt.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_FIRST_NAME=System
SYSTEM_ADMIN_LAST_NAME=Administrator
SYSTEM_ADMIN_PASSWORD=
